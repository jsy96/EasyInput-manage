{
  "name": "easyinput-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop monitor and firmware manager for the EasyInput V2 development board",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "package:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "esptool-js": "^0.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/w3c-web-serial": "^1.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.waytoagi.easyinput-studio",
    "productName": "EasyInput Studio",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
