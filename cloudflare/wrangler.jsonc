{
  "name": "easyinput-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoomV2" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceRoom"] },
    { "tag": "v2", "renamed_classes": [{ "from": "DeviceRoom", "to": "DeviceRoomV2" }] }
  ],
  "vars": {
    "PUBLIC_DEVICE_ID": "easyinput-v2",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,https://studio.leige.online"
  },
  "routes": [
    { "pattern": "easy.leige.online", "custom_domain": true }
  ]
}
